#!/usr/bin/env bash
# =============================================================================
# common.env — Shared configuration for the LMcache355 benchmark suite
# =============================================================================
#
# WHAT THIS IS
#   Single source of truth for every variable the benchmark scripts in this
#   directory depend on (model path, server endpoint, the LMCache hash fix,
#   GPU mapping, tokenizer). Each script does `source common.env` at the top so
#   the whole suite stays consistent and reproducible.
#
# HOW TO USE
#   Do NOT run this file directly. It is sourced by 00_serve_minimax.sh,
#   01..04_*.sh. Override any value inline, e.g.:
#       PORT=8801 TP=4 GPUS=2,3,5,6 ./00_serve_minimax.sh
#
# HARDWARE / SOFTWARE GROUND TRUTH (captured 2026-06-16)
#   - 8x AMD MI355X (gfx950), 288 GB HBM/GPU (309 GB raw). NOTE: blog used
#     MI300X/gfx942 — this suite is the gfx950 port.
#   - ROCm 7.2.1, Python 3.12, torch 2.10 ROCm build (HIP masquerades as cuda).
#   - vLLM: in-tree dev build at /shareddata/adrana/workspace/vllm-pr
#     (carries TurboQuant/FlyDSL KV kernels — the eventual unit-under-test).
#   - LMCache: source-built with BUILD_WITH_HIP=1 (PyPI wheel is CUDA-only).
#   - We are already INSIDE a container; the blog's `docker run` step is skipped.
# =============================================================================

# ----- Model -----------------------------------------------------------------
# MiniMax-M2.5 = the exact model from the blog. The public MiniMaxAI/MiniMax-M2.5
# repo is ALREADY block-FP8 (quant_method=fp8, float8_e4m3fn, weight_block_size
# [128,128]) => same precision as the blog's "230 GB FP8 MoE". 125 shards,
# ~230 GB safetensors. Downloaded 2026-06-16 to the path below.
#   arch=MiniMaxM2ForCausalLM  layers=62  hidden=3072  heads=48  kv_heads=8
#   head_dim=128  experts=256 (top-8)  max_pos=196608  vocab=200064
export MODEL_PATH="${MODEL_PATH:-/shareddata/adrana/workspace/models/MiniMax-M2.5}"
export SERVED_NAME="${SERVED_NAME:-minimax-m2.5}"

# Tokenizer used by the client-side testers to size prompts to an exact token
# count. Must match the served model so context-size targeting is accurate.
export TOKENIZER="${TOKENIZER:-$MODEL_PATH}"

# ----- Server endpoint -------------------------------------------------------
export PORT="${PORT:-8800}"
export HOST="${HOST:-0.0.0.0}"
export ENDPOINT="${ENDPOINT:-http://127.0.0.1:${PORT}}"

# ----- Tensor parallelism / GPU mapping --------------------------------------
# BLOG SETTING: TP=2 (Section 4 "Common settings"). The blog also explicitly
# warns against TP>4 with LMCacheConnectorV1 (Finding "When NOT to deploy":
# "TP > 4 with vLLM 0.19.x — KV connector deadlock risk") and documents a TP=2
# shm_broadcast deadlock under sustained load (Finding 4). So TP=2 is both the
# blog default AND the safe choice.
#
# FIT / PRESSURE FACTS (MiniMax-M2.5 is FP8, ~230 GB safetensors — SAME precision
# as the blog; the public MiniMaxAI/MiniMax-M2.5 repo is already block-FP8):
#   Blog node = 2x192 = 384 GB; ours = 2x288 = 576 GB (+50% HBM).
#   The KV-cache test depends on the KV POOL = usable_HBM - weights, not raw gmu.
#     Blog @gmu0.78: 384*0.78 - 230 = ~70 GB KV pool  (~6 x 100k-ctx @12 GB)
#     Ours @gmu0.78: 576*0.78 - 230 = ~219 GB KV pool (~18 x 100k-ctx) -> less pressure
#   To make the KV-cache test EQUIVALENT, match the KV pool (see GPU_MEM_UTIL_KVMATCH).
#
# GPU OCCUPANCY varies. Check before serving:
#   rocm-smi --showmeminfo vram | grep Used
# Set GPUS to two FREE GPUs; length of GPUS must equal $TP.
export TP="${TP:-2}"
export GPUS="${GPUS:-1,3}"          # comma list, length must equal $TP

# ----- vLLM KV / memory knobs ------------------------------------------------
# BLOG SETTING (Section 4): gpu-memory-utilization = 0.85 for base/Phase-2,
# and 0.78 for the STRESS phase (to force HBM pressure). The per-phase scripts
# set GPU_MEM_UTIL accordingly; this is the base/default.
export GPU_MEM_UTIL="${GPU_MEM_UTIL:-0.85}"
# Blog stress context is 100k; allow up to 128k so 100k requests fit.
export MAX_MODEL_LEN="${MAX_MODEL_LEN:-131072}"

# ----- KV-pool matching to the blog (fair KV-cache comparison) ----------------
# The blog's stress regime works because its KV pool (~70 GB) only holds ~6
# concurrent 100k contexts before spilling to the CPU-DRAM L2. Our bigger HBM
# would hold ~18 at the same gmu, so the L2 sees less pressure and LMCache's win
# shrinks. To reproduce the blog's REGIME (not just its literal knobs), match the
# KV pool by lowering gmu:
#     gmu_match = (blog_KV_pool + weights) / our_node = (70 + 230) / 576 = 0.52
# Use MODE=stress_kvmatched in 03_trace_replay.sh, or pass GPU_MEM_UTIL=0.52.
# CALIBRATED from a real boot (2026-06-16, gmu=0.85 on 2x288 GiB MI355X):
#   vLLM reported GPU KV cache size = 1,113,664 tokens = ~263 GiB pool.
#   => reserved (weights + activation overhead) = 0.85*576 - 263 = ~226 GiB.
#   Blog stress KV pool (GiB) = 384*0.78 - 214.3(weights) = ~85 GiB.
#   gmu to reproduce the blog's 85 GiB pool on our node, accounting for the
#   MEASURED ~226 GiB reserved:  (85 + 226)/576 = 0.541.
# (The earlier paper estimate 0.52 ignored vLLM's ~12 GiB activation overhead;
#  0.54 is the calibrated value. Re-derive if the model/overhead changes.)
export NODE_HBM_GIB="${NODE_HBM_GIB:-576}"          # 2x288 GiB MI355X (torch total_memory)
export RESERVED_GIB="${RESERVED_GIB:-226}"          # MEASURED weights+overhead @ boot
export BLOG_KV_POOL_GIB="${BLOG_KV_POOL_GIB:-85}"   # blog stress KV pool @gmu0.78 (GiB)
export GPU_MEM_UTIL_KVMATCH="${GPU_MEM_UTIL_KVMATCH:-$(python3 -c "print(round((${BLOG_KV_POOL_GIB}+${RESERVED_GIB})/${NODE_HBM_GIB},3))")}"

# ----- LMCache (CPU-DRAM L2 tier) --------------------------------------------
# BLOG SETTING (Step 4 / Section 4): LMCACHE_LOCAL_CPU=true, CHUNK_SIZE=256,
# MAX_LOCAL_CPU_SIZE=64 (GB). We keep 64 to match the blog exactly. (We have
# ~2.9 TB DRAM free so it could be larger, but matching the blog is the point;
# override LMCACHE_MAX_LOCAL_CPU_SIZE if you want to explore a bigger L2.)
export LMCACHE_LOCAL_CPU="${LMCACHE_LOCAL_CPU:-true}"
export LMCACHE_MAX_LOCAL_CPU_SIZE="${LMCACHE_MAX_LOCAL_CPU_SIZE:-256}"  # GB host RAM for L2. blog=64; the gfx950/MI355 port standardized on 256 (see figuresBF16/RESULTS.md "The L2 had to be 256 GB"): on faster silicon a 64 GB tier thrashes as ~16 concurrent prefills evict reusable prefixes, and 256 GB sizes the tier to the WORKING SET IN TOKENS. This 256 is the BF16 size. NOTE: the fair TQ44 L2 is NOT 256 — it is TOKEN-matched, not byte-matched: TQ44 KV is ~3.76x denser, so the same token working set fits in 256/3.76 ≈ 68 GB. common_tq44.env force-overrides this to the token-matched value (see its "L2 TOKEN-MATCH" block). (Do NOT raise to 512: it over-pins host RAM and stalls boot in uninterruptible sleep.)
export LMCACHE_CHUNK_SIZE="${LMCACHE_CHUNK_SIZE:-256}"
# Do NOT enable LMCACHE_SAVE_DECODE_CACHE — it stalls decode (blog warning).

# ----- KV-cache configuration A/B/C (the blog's head-to-head) -----------------
# The blog runs EVERY phase under three configs and the whole story is the
# comparison (Findings 1 & 5). Select with KV_CONFIG:
#   A = vanilla, NO cache     -> vllm --no-enable-prefix-caching
#   B = HBM prefix cache only -> vllm --enable-prefix-caching
#   C = LMCache CPU-DRAM L2   -> --enable-prefix-caching + LMCacheConnectorV1 (default)
# 00_serve_minimax.sh reads this to assemble the right server flags.
export KV_CONFIG="${KV_CONFIG:-C}"

# ----- MiniMax-M2 specific serving flags (blog Step 4 / Reproduce) ------------
# The blog's MiniMax launch adds --tool-call-parser minimax_m2 / --reasoning-parser
# minimax_m2 / --enable-auto-tool-choice. Those only affect PARSING of tool-call /
# reasoning OUTPUT — irrelevant for KV-cache benchmarking (we send prompts and
# measure TTFT / cache hits). The existing working MiniMax serve scripts on THIS
# vLLM build (vllm-pr/benchmarks/lcb_minimax_*.sh) do NOT use them, and we can't
# confirm the parser is registered in this dev build. So default OFF to avoid a
# boot failure. Set MINIMAX_PARSERS=1 to match the blog's full agentic setup
# (only if your vLLM registers the minimax_m2 parsers).
export MINIMAX_PARSERS="${MINIMAX_PARSERS:-1}"

# ----- THE HASH FIX (critical, see NOTES.md "HASH FIX") ----------------------
# Two bugs share one symptom (phantom 0% cache hits at TP>1):
#   A) Python builtin hash() is per-process randomized -> TP workers compute
#      DIFFERENT cache keys unless PYTHONHASHSEED is pinned.
#   B) LMCache's default pre_caching_hash_algorithm="builtin" is REJECTED by our
#      newer vLLM's get_hash_fn_by_name() (accepts sha256/xxhash/...), so LMCache
#      silently falls back to builtin hash() — re-introducing (A) AND diverging
#      from vLLM's own prefix-cache algo.
# FIX: pin the seed, force LMCache to sha256, and align vLLM's prefix-cache algo
# to sha256 too. The blog didn't hit (B) because it ran a version-matched pinned
# vLLM in the official container; we run LMCache main vs a custom vLLM, so we are
# first to surface it.
export PYTHONHASHSEED="${PYTHONHASHSEED:-0}"
export LMCACHE_PRE_CACHING_HASH_ALGORITHM="${LMCACHE_PRE_CACHING_HASH_ALGORITHM:-sha256}"
export PREFIX_HASH_ALGO="${PREFIX_HASH_ALGO:-sha256}"   # -> vllm --prefix-caching-hash-algo

# ----- vLLM runtime ----------------------------------------------------------
export VLLM_USE_V1="${VLLM_USE_V1:-1}"

# ----- Paths -----------------------------------------------------------------
# BENCH_DIR defaults to the directory THIS file lives in, so the vendored example
# is self-contained: logs/ and results/ land beside the scripts regardless of
# where the LMCache repo was cloned. Override BENCH_DIR to relocate outputs.
_COMMON_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export BENCH_DIR="${BENCH_DIR:-$_COMMON_ENV_DIR}"
# TESTER_DIR/TRACE_DIR are only used by the full trace-replay phases (NOT vendored
# in this minimal example — serve + sanity do not need them). Left overridable so
# the same env works if you later drop the kv-cache-tester traces alongside it.
export TESTER_DIR="${TESTER_DIR:-$BENCH_DIR/kv-cache-tester}"
export TRACE_DIR="${TRACE_DIR:-$TESTER_DIR/traces}"
export LOG_DIR="${LOG_DIR:-$BENCH_DIR/logs}"
export RESULTS_DIR="${RESULTS_DIR:-$BENCH_DIR/results}"
mkdir -p "$LOG_DIR" "$RESULTS_DIR"

# ----- Helper: wait until the server answers /v1/models ----------------------
wait_for_server() {
  local url="${1:-$ENDPOINT}/v1/models"
  local timeout="${2:-1800}"   # MiniMax load is slow; allow 30 min
  local waited=0
  echo "Waiting for server at $url (timeout ${timeout}s) ..."
  while ! curl -s "$url" >/dev/null 2>&1; do
    sleep 5; waited=$((waited+5))
    if [ "$waited" -ge "$timeout" ]; then
      echo "ERROR: server did not come up within ${timeout}s" >&2
      return 1
    fi
  done
  echo "Server is up after ${waited}s."
}

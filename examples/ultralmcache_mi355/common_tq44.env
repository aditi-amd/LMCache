#!/usr/bin/env bash
# =============================================================================
# common_tq44.env — TurboQuant-44 (FlyDSL v4) overlay on top of common.env
# =============================================================================
#
# WHAT THIS IS
#   The UltraTQ / TurboQuant-4bit (TQ44) variant of the benchmark config. It
#   sources common.env (so the model path, hash fix, LMCache knobs, trace dir,
#   and wait_for_server helper are inherited unchanged) and then OVERRIDES only
#   what TQ44 needs: the FlyDSL kernel env block, the 4-bit KV cache dtype, the
#   32-token paged block, the AITER unified attention backend, and the
#   recalibrated gmu for the stress regime.
#
# WHY A SEPARATE OVERLAY (not edits to common.env)
#   The BF16 suite is validated and the source of the published Phase 2/3
#   tables. We must not perturb it. Source THIS file instead of common.env for
#   any TQ44 run:
#       source common_tq44.env
#   00_serve_minimax.sh reads the KV_CACHE_DTYPE / BLOCK_SIZE / ATTN_BACKEND /
#   COMPILATION_CONFIG pass-throughs (added in the parametrized serve script);
#   when those are empty (BF16 default) behavior is identical to before.
#
# THE KERNEL (validated, commit 0136dd2ae "Fix SoA cached-prefix decode read")
#   FlyDSL v4 decode + SoA fusion store. Butterfly opts are kept OFF (both
#   flags = 0) because the butterfly store/decode rotation pair has NOT been
#   validated against the multi-turn / prefix-cache read path. VLLM_ROCM_USE_AITER
#   MUST be 0 (=1 caused TQ44 incoherent-decode on MiniMax in a May ablation);
#   the AITER attention *backend* is still selected via --attention-backend
#   ROCM_AITER_UNIFIED_ATTN, which is a different thing from the AITER kernel lib.
# =============================================================================

HERE_TQ44="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Pull in everything from the BF16 baseline first; we only override below.
source "$HERE_TQ44/common.env"

# ----- FlyDSL kernel location (HOW_TO_RUN.md assumes /opt/FlyDSL; on THIS box
#       the build lives at /root/FlyDSL — verified 2026-06-18) -----------------
export VLLM_FLYDSL_ROOT="${VLLM_FLYDSL_ROOT:-/root/FlyDSL}"
export VLLM_FLYDSL_PKGS="${VLLM_FLYDSL_PKGS:-/root/FlyDSL/build-fly/python_packages}"
# Prepend FlyDSL to PYTHONPATH so the kernel package imports resolve.
export PYTHONPATH="${VLLM_FLYDSL_ROOT}:${VLLM_FLYDSL_PKGS}${PYTHONPATH:+:$PYTHONPATH}"

# ----- TurboQuant FlyDSL v4 env block (HOW_TO_RUN.md Part 3, butterfly OFF) ---
export VLLM_TQ_DECODE_V4="${VLLM_TQ_DECODE_V4:-1}"
export VLLM_TQ_DECODE_V3="${VLLM_TQ_DECODE_V3:-0}"
export VLLM_TQ_DECODE_V2="${VLLM_TQ_DECODE_V2:-0}"
export VLLM_TQ_SOA_FUSION_STORE="${VLLM_TQ_SOA_FUSION_STORE:-1}"   # SoA store -> needs SoA-aware v3 read (0136dd2ae)
export VLLM_TQ_SOA_FUSION="${VLLM_TQ_SOA_FUSION:-0}"
export VLLM_TQ_DECODE_V4_WHT_BUTTERFLY="${VLLM_TQ_DECODE_V4_WHT_BUTTERFLY:-0}"  # OFF: not validated on prefix path
export VLLM_TQ_STORE_WHT_BUTTERFLY="${VLLM_TQ_STORE_WHT_BUTTERFLY:-0}"          # OFF: must match decode flag
export HSA_NO_SCRATCH_RECLAIM="${HSA_NO_SCRATCH_RECLAIM:-1}"
export VLLM_ROCM_USE_AITER="${VLLM_ROCM_USE_AITER:-0}"             # 0 mandatory (=1 -> incoherent TQ44 decode)

# ----- vLLM serve flags that 00_serve_minimax.sh passes through ---------------
# (empty in common.env -> BF16 default path; set here to switch on TQ44)
export KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-turboquant_4bit_nc}"
export BLOCK_SIZE="${BLOCK_SIZE:-32}"                              # TQ44 requirement
export ATTN_BACKEND="${ATTN_BACKEND:-ROCM_AITER_UNIFIED_ATTN}"
# Assign the JSON to a literal first; using it directly as a ${VAR:-{...}}
# default makes bash mis-parse the brace and emit a doubled closing '}}'.
_TQ44_DEFAULT_CC='{"cudagraph_mode":"FULL_AND_PIECEWISE"}'
export COMPILATION_CONFIG="${COMPILATION_CONFIG:-$_TQ44_DEFAULT_CC}"

# ----- BLOCK / CHUNK ALIGNMENT (verified) -------------------------------------
# LMCACHE_CHUNK_SIZE (256, inherited from common.env) must be a multiple of the
# vLLM paged BLOCK_SIZE (32). 256 / 32 = 8 -> ALIGNED. LMCache stores/loads in
# whole chunks; a chunk spans exactly 8 paged blocks, so no block straddles a
# chunk boundary. (Divisibility is necessary but NOT sufficient — see
# SCENARIO_TQ44.md "LMCache TQ44 layout risk" for the deeper concern that
# LMCache's GPU connector has no format enum for the packed TQ44 SoA slot.)
if [ $(( LMCACHE_CHUNK_SIZE % BLOCK_SIZE )) -ne 0 ]; then
  echo "ERROR(common_tq44.env): LMCACHE_CHUNK_SIZE=$LMCACHE_CHUNK_SIZE is not a" >&2
  echo "  multiple of BLOCK_SIZE=$BLOCK_SIZE — TQ44 chunk/block misalignment." >&2
  return 1 2>/dev/null || exit 1
fi

# ----- gmu CALIBRATION for the TQ44 stress regime ----------------------------
# TQ44 KV is ~3.76x denser than BF16 (66 KiB/token vs 248 KiB/token). At the
# BF16 KV-matched gmu (0.54) the SAME GiB pool would hold ~13x 100k-ctx instead
# of ~3.6x, so HBM never fills and the stress test collapses (B and C tie).
#
# OPERATING POINT = gmu 0.475 (KV pool ~47.6 GiB). This is the EMPIRICALLY
# CALIBRATED stress point — NOT the naive "blog token budget" of 22.6 GiB/0.432.
# RESOLVED by experiment (see results_tq44/PHASE3_TQ44.md):
#   * 0.432 (22.6 GiB, ~312k tok) is TOO TIGHT: both B and C saturate (0%
#     goodput, p95 95-112s) so there is NO "B stressed / C rescues" separation,
#     and C additionally crashed on the tight pool. More eviction is WORSE here
#     because it over-saturates B instead of leaving it functional.
#   * 0.54 (too loose) never fills HBM -> no eviction -> B ties C.
#   * 0.475 is the Goldilocks point: HBM fills + evicts (11.8k DRAM load-backs
#     observed), B stays functional (76% goodput, fails p95), C rescues (98%) ->
#     a clean, measurable C-beats-B. BF16/TQ44/fp8g32 all use 0.475 (apples).
#   reserved (weights+overhead) = $RESERVED_GIB GiB  (from common.env)
#   TQ44 stress pool            = 47.6 GiB
#   gmu = (47.6 + RESERVED_GIB) / NODE_HBM_GIB = (47.6 + 226) / 576 = 0.475
# (To explore the aggressive token-matched point, set TQ44_KV_POOL_GIB=22.6 ->
#  gmu 0.432, but expect B/C to both saturate per the finding above.)
export TQ44_KV_POOL_GIB="${TQ44_KV_POOL_GIB:-47.6}"   # calibrated stress pool (gmu 0.475)
export GPU_MEM_UTIL_KVMATCH="$(python3 -c "print(round((${TQ44_KV_POOL_GIB}+${RESERVED_GIB})/${NODE_HBM_GIB},3))")"
export TQ44_GMU_FALLBACK="${TQ44_GMU_FALLBACK:-0.45}" # safer boot if 0.475 OOMs at init

# ----- L2 (CPU-DRAM) TOKEN-MATCH — the same fairness rule as gmu, applied to DRAM
# common.env sizes the BF16 L2 at 256 GB to hold the working set IN TOKENS. TQ44 KV
# is ~3.76x denser, so the IDENTICAL token working set fits in 256/3.76 ≈ 68 GB of
# host RAM. We MUST token-match (not byte-match) the L2, exactly as gmu token-matches
# the HBM pool: a byte-matched 256 GB L2 on TQ44 would hold 3.76x MORE tokens, never
# fill, never evict -> no DRAM pressure -> the offload tier is never exercised and the
# A/B/C comparison is unfair (same failure mode the gmu block fixes for HBM).
# This is also a HEADLINE RESULT: TQ44+LMCache holds the SAME reuse working set in
# 3.76x LESS host RAM. Override TQ44_L2_GIB to explore a different L2.
export BF16_L2_REF_GIB="${BF16_L2_REF_GIB:-256}"     # BF16 baseline L2 (common.env), GB
export TQ44_KV_DENSITY="${TQ44_KV_DENSITY:-3.76}"    # 248 KiB/tok (BF16) / 66 KiB/tok (TQ44)
export TQ44_L2_GIB="${TQ44_L2_GIB:-$(python3 -c "print(round(${BF16_L2_REF_GIB}/${TQ44_KV_DENSITY}))")}"  # ≈68 GB token-matched
export LMCACHE_MAX_LOCAL_CPU_SIZE="$TQ44_L2_GIB"     # FORCE token-matched L2 (override common.env's 256)

# ----- Output namespacing so TQ44 results never overwrite the BF16 tables -----
export RESULTS_DIR="${RESULTS_DIR_TQ44:-$BENCH_DIR/results_tq44}"
export LOG_DIR="${LOG_DIR_TQ44:-$BENCH_DIR/logs_tq44}"
mkdir -p "$RESULTS_DIR" "$LOG_DIR"

echo "[common_tq44.env] TQ44 overlay loaded:"
echo "    KV dtype     : $KV_CACHE_DTYPE   block-size: $BLOCK_SIZE   backend: $ATTN_BACKEND"
echo "    FlyDSL       : $VLLM_FLYDSL_ROOT (v4 decode, butterfly OFF, AITER kernel OFF)"
echo "    gmu KVMATCH  : $GPU_MEM_UTIL_KVMATCH  (fallback $TQ44_GMU_FALLBACK)  pool≈${TQ44_KV_POOL_GIB} GiB"
echo "    L2 token-mtch: $LMCACHE_MAX_LOCAL_CPU_SIZE GB  (BF16 ${BF16_L2_REF_GIB} GB / ${TQ44_KV_DENSITY}x density — same tokens, ${TQ44_KV_DENSITY}x less host RAM)"
echo "    chunk/block  : $LMCACHE_CHUNK_SIZE / $BLOCK_SIZE  (= $(( LMCACHE_CHUNK_SIZE / BLOCK_SIZE ))x, aligned)"
echo "    results dir  : $RESULTS_DIR"

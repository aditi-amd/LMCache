#!/usr/bin/env bash
# =============================================================================
# common_fp8g32.env — UltraQuant fp8_kv_g32 overlay on top of common.env
# =============================================================================
#
# WHAT THIS IS
#   The UltraQuant (fp8_kv_g32) variant of the benchmark config: FP4 E2M1 codes
#   + UE8M0 (1-byte E8M0) per-group-of-32 scales + FP8-E4M3 query path, decoded
#   by the **pure-Triton fp8_g32 V3** unified kernel (no FlyDSL / HIP dep). On-
#   device slot is 136 B/head (vs TQ44's 134 B) — same packed uint8 [NB,BS,NH,
#   slot] contract, so LMCache's group-aware connector offloads it unchanged.
#
#   It sources common.env (model path, hash fix, LMCache knobs, trace dir,
#   wait_for_server) and OVERRIDES only what fp8_kv_g32 needs.
#
# WHY A SEPARATE OVERLAY (not edits to common_tq44.env / common.env)
#   The BF16 baseline and the TQ44 suite are validated and are the source of the
#   published tables. We must NOT perturb either. Source THIS file instead for
#   any UltraQuant run:
#       source common_fp8g32.env
#   00_serve_minimax.sh reads the KV_CACHE_DTYPE / BLOCK_SIZE / ATTN_BACKEND /
#   COMPILATION_CONFIG pass-throughs exactly as it does for TQ44; the extra
#   VLLM_FP8_G32_* env vars exported here are inherited by the exec'd server.
#
# THE KERNEL (HOW_TO_RUN.md "FP8-g32 (fp8_kv_g32)")
#   VLLM_FP8_G32_V3=1 is the ONLY required env var; everything else defaults to
#   production-ready values. Pure Triton: K path uses tl.dot_scaled (native
#   scaled F8F6F4 MFMA on CDNA4); V path uses arithmetic FP4 decode (V_ARITH=1).
#   Layout is AoS (VLLM_FP8_G32_SOA_SCALES=0) — no SoA flag needed for LMCache.
#
#   VLLM_ROCM_USE_AITER: the fp8_g32 HOW_TO_RUN example uses =1 (on Qwen-72B),
#   but on MiniMax the AITER *kernel lib* caused incoherent TQ44 decode, so we
#   DEFAULT IT OFF here for safety and let bring-up A/B it. The AITER attention
#   *backend* (--attention-backend ROCM_AITER_UNIFIED_ATTN) is a different thing
#   and is still selected, exactly as for TQ44.
# =============================================================================

HERE_FP8="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Pull in everything from the BF16 baseline first; we only override below.
source "$HERE_FP8/common.env"

# ----- FlyDSL location (HOW_TO_RUN.md "FP8-g32 FlyDSL V4", recommended gfx950) -
# fp8_g32 V4 FlyDSL decode is a direct port of the bug-free TQ V4 kernel and is
# the FASTEST path on MI355X (HOW_TO_RUN.md §"FP8-g32 FlyDSL V4": 303.4 OutTPS,
# +44% vs TQ44 V3 Triton, vs the V3 Triton path's 199.2). It needs FlyDSL on
# PYTHONPATH (same build TQ44 uses) and has a GQA-6 sibling kernel for MiniMax.
export VLLM_FLYDSL_ROOT="${VLLM_FLYDSL_ROOT:-/root/FlyDSL}"
export VLLM_FLYDSL_PKGS="${VLLM_FLYDSL_PKGS:-/root/FlyDSL/build-fly/python_packages}"
export PYTHONPATH="${VLLM_FLYDSL_ROOT}:${VLLM_FLYDSL_PKGS}${PYTHONPATH:+:$PYTHONPATH}"

# ----- fp8_g32 V4 FlyDSL decode (recommended) + V3 Triton fallback ------------
export VLLM_FP8_G32_DECODE_V4="${VLLM_FP8_G32_DECODE_V4:-1}"   # FlyDSL decode (GQA-6 kernel for MiniMax); eligible: D=128, GQA{6,8,16}
export VLLM_FP8_G32_V3="${VLLM_FP8_G32_V3:-1}"                 # Triton fallback (continuation prefill / ineligible layers)
# CDNA4 hw opts (default ON in code; pinned here so the config is self-documenting
# and robust to future default changes — HOW_TO_RUN.md §"CDNA4 hardware optimizations")
export VLLM_FP8_G32_DECODE_V4_QK_SCALED="${VLLM_FP8_G32_DECODE_V4_QK_SCALED:-1}"  # native scaled FP4xFP8 MFMA for QK (gfx950)
export VLLM_FP8_G32_DECODE_V4_V_CVT="${VLLM_FP8_G32_DECODE_V4_V_CVT:-1}"          # native FP4->bf16 hw CVT for V dequant
export VLLM_FP8_G32_DECODE_V4_Q_HOIST="${VLLM_FP8_G32_DECODE_V4_Q_HOIST:-1}"      # hoist scaled-MFMA Q operand out of K-tile loop
export VLLM_FP8_G32_SOA_SCALES="${VLLM_FP8_G32_SOA_SCALES:-0}"  # AoS store (LMCache-safe; FlyDSL V4 validated with AoS default)
export VLLM_FP8_G32_V_ARITH="${VLLM_FP8_G32_V_ARITH:-1}"        # arithmetic FP4 V-decode (default ON, bit-identical)
export VLLM_FP8_G32_ARCHB="${VLLM_FP8_G32_ARCHB:-0}"           # Arch A codebook (must match how model was quantized)
export HSA_NO_SCRATCH_RECLAIM="${HSA_NO_SCRATCH_RECLAIM:-1}"
export VLLM_ROCM_USE_AITER="${VLLM_ROCM_USE_AITER:-0}"        # 0 for MiniMax safety; bring-up may A/B =1

# ----- vLLM serve flags that 00_serve_minimax.sh passes through ---------------
# (empty in common.env -> BF16 default path; set here to switch on fp8_kv_g32)
export KV_CACHE_DTYPE="${KV_CACHE_DTYPE:-fp8_kv_g32}"
export BLOCK_SIZE="${BLOCK_SIZE:-32}"                          # packed-path requirement
export ATTN_BACKEND="${ATTN_BACKEND:-ROCM_AITER_UNIFIED_ATTN}"
# Assign the JSON to a literal first (same brace-parse caveat as common_tq44.env).
_FP8_DEFAULT_CC='{"cudagraph_mode":"FULL_AND_PIECEWISE"}'
export COMPILATION_CONFIG="${COMPILATION_CONFIG:-$_FP8_DEFAULT_CC}"

# ----- BLOCK / CHUNK ALIGNMENT (verified, same rule as TQ44) ------------------
# LMCACHE_CHUNK_SIZE (256, from common.env) must be a multiple of BLOCK_SIZE
# (32). 256/32 = 8 -> ALIGNED. Whole-block capture is what makes the packed
# offload byte-exact (a 136-B slot never straddles a chunk boundary).
if [ $(( LMCACHE_CHUNK_SIZE % BLOCK_SIZE )) -ne 0 ]; then
  echo "ERROR(common_fp8g32.env): LMCACHE_CHUNK_SIZE=$LMCACHE_CHUNK_SIZE is not a" >&2
  echo "  multiple of BLOCK_SIZE=$BLOCK_SIZE — fp8g32 chunk/block misalignment." >&2
  return 1 2>/dev/null || exit 1
fi

# ----- gmu CALIBRATION for the fp8g32 stress regime --------------------------
# fp8_kv_g32 KV is ~3.70x denser than BF16 (slot 136 B vs TQ44 134 B; both pack
# the middle layers, BF16 boundary layers identical).
#
# OPERATING POINT = gmu 0.475 (KV pool ~47.6 GiB). EMPIRICALLY CALIBRATED, same
# as TQ44 — NOT the naive 22.6 GiB/0.432 "blog token budget". Per
# results_tq44/PHASE3_TQ44.md, 0.432 (~312k-token pool) is TOO TIGHT: both B and
# C saturate (0% goodput) so there is no "B stressed / C rescues" separation
# (and C crashed on the tight pool). 0.475 fills+evicts HBM while leaving B
# functional, giving a clean C-beats-B. BF16/TQ44/fp8g32 all run at this 0.475
# so the comparison is apples-to-apples (and at equal density the token pools
# match: fp8g32 643,232 tok vs TQ44 650,816 tok, within ~1.2%).
#   reserved (weights+overhead) = $RESERVED_GIB GiB  (from common.env)
#   fp8g32 stress pool          = 47.6 GiB
#   gmu = (47.6 + RESERVED_GIB) / NODE_HBM_GIB = (47.6 + 226) / 576 = 0.475
export FP8G32_KV_POOL_GIB="${FP8G32_KV_POOL_GIB:-47.6}"   # calibrated stress pool (gmu 0.475)
export GPU_MEM_UTIL_KVMATCH="$(python3 -c "print(round((${FP8G32_KV_POOL_GIB}+${RESERVED_GIB})/${NODE_HBM_GIB},3))")"
export FP8G32_GMU_FALLBACK="${FP8G32_GMU_FALLBACK:-0.45}"

# ----- L2 (CPU-DRAM) TOKEN-MATCH — same fairness rule as gmu, applied to DRAM -
# BF16 L2 = 256 GB holds the working set IN TOKENS; fp8g32 KV is ~3.70x denser,
# so the IDENTICAL token working set fits in 256/3.70 ≈ 69 GB of host RAM. Token-
# match (not byte-match) the L2 or the A/B/C comparison is unfair (the tier never
# fills, never evicts). Override FP8G32_L2_GIB to explore a different L2.
export BF16_L2_REF_GIB="${BF16_L2_REF_GIB:-256}"
export FP8G32_KV_DENSITY="${FP8G32_KV_DENSITY:-3.70}"   # ~ TQ44 3.76 * 134/136
export FP8G32_L2_GIB="${FP8G32_L2_GIB:-$(python3 -c "print(round(${BF16_L2_REF_GIB}/${FP8G32_KV_DENSITY}))")}"  # ≈69 GB token-matched
export LMCACHE_MAX_LOCAL_CPU_SIZE="$FP8G32_L2_GIB"      # FORCE token-matched L2 (override common.env's 256)

# ----- Output namespacing so fp8g32 results never overwrite BF16/TQ44 tables --
export RESULTS_DIR="${RESULTS_DIR_FP8G32:-$BENCH_DIR/results_fp8g32}"
export LOG_DIR="${LOG_DIR_FP8G32:-$BENCH_DIR/logs_fp8g32}"
mkdir -p "$RESULTS_DIR" "$LOG_DIR"

echo "[common_fp8g32.env] UltraQuant fp8_kv_g32 overlay loaded:"
echo "    KV dtype     : $KV_CACHE_DTYPE   block-size: $BLOCK_SIZE   backend: $ATTN_BACKEND"
echo "    kernel       : fp8_g32 V4 FlyDSL decode (V3 Triton fallback)  DECODE_V4=$VLLM_FP8_G32_DECODE_V4 V3=$VLLM_FP8_G32_V3 SOA=$VLLM_FP8_G32_SOA_SCALES AITER=$VLLM_ROCM_USE_AITER"
echo "    flydsl       : $VLLM_FLYDSL_ROOT (fp8_g32 v4 decode, GQA-6 sibling for MiniMax)"
echo "    gmu KVMATCH  : $GPU_MEM_UTIL_KVMATCH  (fallback $FP8G32_GMU_FALLBACK)  pool≈${FP8G32_KV_POOL_GIB} GiB"
echo "    L2 token-mtch: $LMCACHE_MAX_LOCAL_CPU_SIZE GB  (BF16 ${BF16_L2_REF_GIB} GB / ${FP8G32_KV_DENSITY}x density)"
echo "    chunk/block  : $LMCACHE_CHUNK_SIZE / $BLOCK_SIZE  (= $(( LMCACHE_CHUNK_SIZE / BLOCK_SIZE ))x, aligned)"
echo "    results dir  : $RESULTS_DIR"
